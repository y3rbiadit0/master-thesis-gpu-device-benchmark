	urldate = {2026-07-25},
	year = {2025},
	date = {2025-08},
	note = {{ISSN}: 2332-5569},
	keywords = {Collective communication, Libraries, Systematics, Training, Artificial intelligence, Communication libraries, Graphics processing units, Heuristic algorithms, Multi-{GPU} cluster training, {NVIDIA} {NCCL}, Object recognition, Performance evaluation, Protocols, Software},
	file = {Full Text PDF:/Users/stormtrooper/Zotero/storage/NIQ3NZ2K/Hu et al. - 2025 - Demystifying NCCL An In-Depth Analysis of GPU Communication Protocols and Algorithms.pdf:application/pdf},
